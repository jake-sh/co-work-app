# Firebase project: co-work (co-work-fd9d3)
# Copy this file to .env.local and fill in the values from the Firebase console
# (Project settings > General > Your apps > SDK setup and configuration).
# Do NOT commit .env.local — it is gitignored.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=co-work-fd9d3.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=co-work-fd9d3
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=co-work-fd9d3.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=875020888077
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web Push (chat notifications). Generate in the Firebase console under
# Project settings > Cloud Messaging > Web configuration > "Web Push
# certificates" (Key pair). Also set this in the Vercel project env.
# Without it, push registration is silently disabled.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# App Check (proves requests to Firestore/Auth come from this app itself,
# not a script replaying a stolen credential). Optional: leave empty to
# skip App Check entirely, unchanged from before this was added.
#
# Setup:
# 1. Firebase console > Build > App Check > Apps > this web app > register
#    a reCAPTCHA v3 provider. Paste the site key it gives you below (also
#    set it in the Vercel project env for the values that need App Check
#    enforced — see step 3).
# 2. Local dev: reCAPTCHA can't verify localhost, so `npm run dev` instead
#    registers this browser as a trusted debug client. Run the app once,
#    copy the debug token it logs to the browser console, and add it under
#    Firebase console > App Check > Apps > this app > Manage debug tokens.
# 3. Once traffic looks right in the App Check console's request metrics
#    (Firestore/Auth), switch enforcement from "Unenforced" to "Enforced"
#    there. Do this for the production domain only at first — Vercel's
#    per-PR preview deploys get a new domain each time and won't have a
#    reCAPTCHA key registered for it, so enforcing there would break those
#    previews until the domain (or a wildcard) is added.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
